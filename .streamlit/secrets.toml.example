# ============================================================
# Streamlit Community Cloud - Configuração de Secrets
# ============================================================
#
# Copie este conteúdo para as Secrets do Streamlit Cloud:
#   https://share.streamlit.io/ -> Seu app -> Settings -> Secrets
#
# Ou para .streamlit/secrets.toml (local):
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# NUNCA versionar o secrets.toml (já está no .gitignore).
# ============================================================

[DB]
SERVER = "seu-servidor.database.windows.net"
DATABASE = "nome_do_banco"
USER = "usuario"
PASSWORD = "senha"
DRIVER = "ODBC Driver 18 for SQL Server"
TIMEOUT = "15"

[TABELAS]
NF_ENTRADA = "SF1010"
NF_SAIDA = "SF2010"
EMPRESAS = "SM0010"
CLIENTES = "SA1010"
FORNECEDORES = "SA2010"
F2D = "F2D010"
ITEM_ENTRADA = "SD1010"
ITEM_SAIDA = "SD2010"
CT2 = "CT2010"
CP = "SE2010"

[TRIBUTOS]
IBS_ENTRADA = "EIBS01"
IBS_SAIDA = "SIBS01"
CBS_ENTRADA = "ECBS01"
CBS_SAIDA = "SCBS01"
