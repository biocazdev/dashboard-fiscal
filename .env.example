# ============================================================
# Dashboard Fiscal Protheus
# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# NUNCA versionar o arquivo .env (já está no .gitignore).
# O usuário do SQL Server deve ter permissão SOMENTE de leitura.
# ============================================================

# Conexão SQL Server
DB_SERVER=SERVIDOR_SQL
DB_DATABASE=C58SCI_213234_PR_DV
DB_USER=DESENVLEITURA
DB_PASSWORD=firdw94861DLWMP!@
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TIMEOUT=15

# ============================================================
# Tabelas físicas do Protheus (configuráveis)
# Valide o sufixo e os campos no dicionário de dados (SX3)
# da instalação antes de implantar.
# ============================================================
TABELA_NF_ENTRADA=SF1010
TABELA_NF_SAIDA=SF2010
# SM0: empresas (M0_CODIGO) e filiais (M0_CODFIL)
# Se o SM0 não existir/estiver acessível, o app lista as filiais
# automaticamente a partir das notas (SF1/SF2).
TABELA_EMPRESAS=SM0010
# Cadastros de parceiros (descrição de clientes e fornecedores).
# SA1 = clientes, SA2 = fornecedores (padrão TOTVS). Se o cadastro
# não existir, o app exibe apenas o código do parceiro.
TABELA_CLIENTES=SA1010
TABELA_FORNECEDORES=SA2010

# Filial padrão a pré-preencher no filtro da sidebar quando o SM0 não
# está disponível/acessível (instalação com empresa/filial única - evita
# ter que digitar o código toda vez que o dashboard é aberto).
# Deixe em branco para não pré-preencher nada.
FILIAL_PADRAO=010101

# ============================================================
# IBS/CBS (reforma tributária) - Configurador de Tributos (F2D)
# Os valores ficam em F2D (tributos calculados), vinculados ao item
# da nota por F2D_IDREL = D1_IDTRIB/D2_IDTRIB. IBS e CBS são
# diferenciados pelo código do tributo (F2D_TRIB).
# Ajuste os códigos conforme o dicionário (SX3) da instalação.
# ============================================================
TABELA_F2D=F2D010
TABELA_ITEM_ENTRADA=SD1010
TABELA_ITEM_SAIDA=SD2010
COD_TRIB_IBS_ENTRADA=EIBS01
COD_TRIB_IBS_SAIDA=SIBS01
COD_TRIB_CBS_ENTRADA=ECBS01
COD_TRIB_CBS_SAIDA=SCBS01

# ============================================================
# Conciliação Fiscal x Contábil (CT2)
# A base está em implantação (CT2 ainda sem dados reais). A chave
# de vínculo fiscal -> contábil usa o padrão TOTVS: filial + CT2_DOC
# + parceiro (CT2_CODPAR/CODCLI/CODFOR). Valide tudo após o GO LIVE.
# ============================================================
# Tabela física de lançamentos contábeis (CT2 = lançamentos).
# OBS.: na instalação atual NÃO existem LCT100/LCT200.
TABELA_CT2=CT2010
# Códigos de CT2_ORIGEM usados na contabilização de entradas/saídas
# (separados por vírgula). Vazio = considera qualquer origem.
# Ex.: "SE2" (contas a pagar) e "SE1" (contas a receber).
CT2_ORIGEM_ENTRADA=
CT2_ORIGEM_SAIDA=
# Filtrar linhas do CT2 por CT2_DC (ex.: "3" ou "1,2"). Vazio = todas.
# IMPORTANTE: validar o significado de CT2_DC na instalação após o GO LIVE.
CT2_FILTRO_DC=
# Exigir que o parceiro (CT2_CODPAR/CT2_CODCLI/CT2_CODFOR) bata com o
# cliente/fornecedor da nota para considerar o documento CONCILIADO.
# Padrão true. Defina false se a instalação NÃO preenche esses campos nos
# lançamentos automáticos do CT2 - nesse caso o vínculo passa a valer só
# por documento (CT2_DOC ou CT2_KEY, ver abaixo) mais origem/DC quando
# configurados.
CT2_EXIGIR_PARCEIRO=true
# Vincular pelo número da nota embutido em CT2_KEY em vez de CT2_DOC.
# Padrão false (usa CT2_DOC diretamente). Ative (true) se a instalação
# grava em CT2_DOC uma numeração interna do lançamento (não o número da
# nota) - nesse caso o número real da nota fica embutido no campo CT2_KEY
# (varchar 200, padrão TOTVS: posições 1-6 = filial, 7-15 = documento,
# 16-18 = série). Valide com um lançamento real antes de ativar.
CT2_DOC_VIA_KEY=false
# Restringe o vínculo via CT2_KEY às linhas cuja CT2_ROTINA esteja nesta
# lista (separados por vírgula; vazio = qualquer rotina). Só tem efeito
# quando CT2_DOC_VIA_KEY=true - reduz o risco de interpretar o CT2_KEY de
# um lançamento de outra origem como se fosse filial+documento+série.
CT2_ROTINA_ENTRADA=
CT2_ROTINA_SAIDA=
# Tolerância (valor absoluto) para considerar um documento CONCILIADO.
TOLERANCIA_CONCILIACAO=0.05
# Rótulos legíveis para o código de CT2_ORIGEM, exibidos na tela em vez do
# código cru (ex.: "SE1" -> "Contas a Receber"). Formato "CODIGO:Rótulo"
# separados por vírgula. Vazio = mostra sempre o código cru.
CT2_ORIGEM_ROTULOS=

# ============================================================
# CFOP (apuração fiscal)
# Nesta instalação NÃO existe D1_CFOP/D2_CFOP (nome padrão). Confirmado em
# 21/08/2026: o CFOP fica em D1_CF/D2_CF (validado com valores reais - ex.:
# saída 5101/5102, entrada 1406/2556/1551). D1_TES/D2_TES é um código
# interno (TES) usado para DERIVAR o CFOP, não é o CFOP em si - não usar.
# Ajuste os campos abaixo se outra instalação usar outro nome.
# ============================================================
CAMPO_CFOP_ENTRADA=D1_CF
CAMPO_CFOP_SAIDA=D2_CF

# ============================================================
# Notas canceladas (apuração fiscal)
# F1_STATUS (SF1) e F2_STATUS (SF2) existem, mas o valor que representa
# "cancelada" ainda não foi confirmado nesta base (sem exemplo real em
# 21/08/2026 - F2_STATUS estava em branco em todas as notas de saída, e
# F1_STATUS só tinha branco/"A"). Filtro DESLIGADO por padrão (vazio).
# Preencha com o(s) valor(es) de cancelado (separados por vírgula) assim
# que identificar uma nota cancelada real - o checklist de qualidade do
# dashboard mostra a distribuição atual de status para ajudar a achar.
# ============================================================
STATUS_CANCELADO_ENTRADA=
STATUS_CANCELADO_SAIDA=

# ============================================================
# Alertas visuais (semáforo)
# Limites que disparam um aviso no topo do dashboard. Ajuste conforme a
# realidade da empresa (ex.: em uma base em implantação, como esta, um %
# de conciliação baixo pode ser normal por um tempo).
# ============================================================
# % mínimo de conciliação esperado (abaixo disso, aviso). 0.80 = 80%.
ALERTA_PCT_CONCILIACAO_MIN=0.80
# Idade (dias) a partir da qual uma pendência gera aviso.
ALERTA_IDADE_PENDENCIA_DIAS=30
# Avisa quando o Saldo de ICMS ficar negativo (crédito acumulado).
ALERTA_SALDO_ICMS_CREDITO=true
# Avisa quando o Saldo de ICMS (positivo ou negativo) ultrapassar este
# valor absoluto. Vazio (padrão) = desligado.
ALERTA_SALDO_ICMS_MAX=

# ============================================================
# Retenções (IR/PIS/COFINS/CSLL) - aba "Retenções", equivalente ao Reinf
# R-4020 (Pagamentos/Créditos a beneficiário PJ). Lê a tabela de contas a
# pagar (SE2), diferente do resto do dashboard (SF1/SF2).
# CONFIRMADO em 25/08/2026: valor retido = E2_IRRF/E2_PIS/E2_COFINS/E2_CSLL
# (não E2_VRETIRF/E2_VRETPIS/E2_VRETCOF/E2_VRETCSL - ficaram zerados).
# ============================================================
TABELA_CP=SE2010

# Campo de CNPJ/CPF no cadastro de fornecedores (SA2) - nome padrão TOTVS,
# AINDA NÃO validado explicitamente nesta instalação.
CAMPO_CNPJ_FORNECEDOR=A2_CGC

# "Cod. R" (natureza de rendimento do Reinf, ex.: 15014) - CONFIRMADO que
# não existe em nenhuma tabela acessível pelo banco (nem no título, nem no
# cadastro de natureza financeira SED010). Mapeamento manual e opcional de
# E2_NATUREZ -> Cod. R, formato "NATUREZA:CODIGO" separados por vírgula.
# Vazio (padrão) = coluna "Cod. R" em branco.
# Ex.: RETENCAO_NATUREZA_CODRET=0000000001:15014,0000000002:15099
RETENCAO_NATUREZA_CODRET=

# ============================================================
# Validação Retenções x Financeiro (SEF) - aba "Retenções x Financeiro"
# Confere se o título com retenção já gerou baixa no Financeiro (SEF010) e
# se o valor líquido baixado bate com Valor do título - retenções. E2_VALOR
# (valor original do título) é campo padrão TOTVS, assumido mas AINDA NÃO
# validado explicitamente nesta instalação.
# ============================================================
TABELA_FINANCEIRO=SEF010

# ============================================================
# CT-e (Conhecimento de Transporte Eletrônico) - aba "🚚 CT-e"
# Esta instalação não usa o módulo de Transporte (TMS) do Protheus - a
# fonte é a tabela genérica de documentos do gerador de SPED Fiscal (C20),
# filtrada pelo campo C20_TPCTE. Tabela vazia nesta base no momento em que
# a aba foi criada (27/08/2026) - ver settings.py/services/cte_service.py
# para o histórico completo da investigação e as ressalvas.
# ============================================================
TABELA_CTE=C20010

# ============================================================
# Anotações locais por documento
# Como o Protheus é acessado somente leitura, as observações do contador
# sobre um documento ficam guardadas neste arquivo SQLite local (não é
# enviado ao Protheus nem versionado no git).
# ============================================================
ANOTACOES_DB=anotacoes.db
